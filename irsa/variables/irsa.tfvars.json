            "tags":{
                "task": "Terraform",
                "purpose": "IAM role for use with K8s service account and pod",
                "team": "DevOps",
                "created": "2022-07-25",
                "createdby": "jkennedy",
                "owner": "jkennedy"
            },
            "actions": [
                "sts:AssumeRoleWithWebIdentity"
            ],
            "type": "Federated",
            "identifiers": [
                "arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/${local.oidc_issuer}"
            ],
            "policies": [
                "admin-role-iam-policy"
            ],
            "ami": ""
        }
